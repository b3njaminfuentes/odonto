generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PatientStatus {
  ACTIVE
  IN_TREATMENT
  CONTROL
  INACTIVE
  ARCHIVED
}

enum AppointmentStatus {
  DISPONIBLE
  PENDIENTE
  CONFIRMADO
  FINALIZADO
  OCUPADO
  CANCELADO
}

enum TreatmentStatus {
  ACTIVO
  COMPLETADO
  PAUSADO
  CANCELADO
}

enum PaymentStatus {
  PENDIENTE
  COMPLETADO
  FALLIDO
  REEMBOLSADO
  CANCELADO
}

// ----------------------------------------------------
// MULTI-TENANT ENTITIES
// ----------------------------------------------------

model Clinic {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique // ej: "villarroel" -> villarroel.clinicos.app
  plan      String   @default("core") // core | pro | enterprise
  createdAt DateTime @default(now())

  branches           Branch[]
  domains            ClinicDomain[]
  settings           ClinicSettings?
  theme              ClinicTheme?
  testimonials       Testimonial[]
  galleryItems       GalleryItem[]
  users              UserClinicMap[]
  patients           Patient[]
  appointments       Appointment[]
  payments           Payment[]
  doctorPayments     DoctorPayment[]
  treatments         Treatment[]
  media              CaseMedia[]
  timelineEvents     TimelineEvent[]
  auditLogs          AuditLog[]
  moldCharts         ToothMoldChart[]
  cephalometricCases CephalometricCase[]

  @@index([slug])
}

model Branch {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @db.Uuid
  name      String
  address   String?
  createdAt DateTime @default(now())

  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patients     Patient[]
  appointments Appointment[]
  users        UserClinicMap[]

  @@index([clinicId])
}

model ClinicDomain {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String   @db.Uuid
  domain    String   @unique // "clinica-villarroel.vercel.app", "villarroel.clinicos.app"
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([domain])
}

model ClinicSettings {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId                 String   @unique @db.Uuid
  phone                    String?
  address                  String?
  currency                 String   @default("BOB")
  doctorName               String?
  specialty                String?
  pendingAppointmentsAlert Boolean  @default(true)
  updatedAt                DateTime @default(now()) @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model ClinicTheme {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String   @unique @db.Uuid
  logoUrl      String?
  primaryColor String   @default("#0F6E56")
  heroImageUrl String?
  heroHeadline String? // Si es null, usa copy default del template
  updatedAt    DateTime @default(now()) @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId   String   @db.Uuid
  authorName String
  authorRole String?
  quote      String
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model GalleryItem {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId String  @db.Uuid
  type     String  // 'before_after' | 'certificate' | 'general'
  imageUrl String
  caption  String?
  order    Int     @default(0)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
}

model UserClinicMap {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  clinicId  String   @db.Uuid
  role      String   @default("doctor") // 'owner' | 'doctor' | 'receptionist' | 'staff'
  branchId  String?  @db.Uuid
  createdAt DateTime @default(now())

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, clinicId])
  @@index([userId])
  @@index([clinicId])
  @@map("user_clinic_map")
}

// ----------------------------------------------------
// CLINICAL ENTITIES
// ----------------------------------------------------

model Profile {
  id        String   @id @db.Uuid // Referencia a auth.users.id
  role      String   @default("patient") // 'admin' | 'doctor' | 'patient'
  email     String   @unique
  firstName String?
  lastName  String?
  specialty String?
  phone     String?
  color     String?  @default("brand")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  patient            Patient?
  appointments       Appointment[]
  historyVersions    ClinicalHistoryVersion[]
  paymentsReceived   DoctorPayment[]
  cephalometricCases CephalometricCase[]

  @@index([email])
}

model Patient {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId              String        @db.Uuid
  branchId              String?       @db.Uuid
  profileId             String?       @unique @db.Uuid
  patientCode           String        @unique
  dni                   String?       @unique
  passport              String?
  firstName             String
  lastName              String
  dob                   DateTime?     @db.Date
  email                 String?       @unique
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  referralSource        String? // Facebook, Instagram, TikTok, Google Maps, Recomendado, Otro
  address               String?
  status                PatientStatus @default(ACTIVE)
  profilePhotoId        String?       @db.Uuid
  accessCode            String?       @unique // Código de acceso al portal
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  clinic             Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch             Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  profile            Profile?               @relation(fields: [profileId], references: [id])
  appointments       Appointment[]
  treatments         Treatment[]
  history            ClinicalHistory?
  odontogram         Odontogram?
  diagnoses          Diagnosis[]
  payments           Payment[]
  events             TimelineEvent[]
  media              CaseMedia[]
  cephalometrics     Cephalometry[]
  moldCharts         ToothMoldChart[]
  cephalometricCases CephalometricCase[]

  @@index([clinicId])
  @@index([branchId])
  @@index([dni])
  @@index([phone])
  @@index([status])
}

model Diagnosis {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId   String   @db.Uuid
  description String
  toothNumber String? // notación FDI
  diagnosedAt DateTime @default(now())
  diagnosedBy String   @db.Uuid
  treatmentId String?  @db.Uuid

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([patientId])
  @@index([treatmentId])
}

model Odontogram {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String   @unique @db.Uuid
  chart     Json
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Cephalometry {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId          String   @db.Uuid
  sna                Decimal? @db.Decimal(5, 2)
  snb                Decimal? @db.Decimal(5, 2)
  anb                Decimal? @db.Decimal(5, 2)
  planoMandibular    Decimal? @db.Decimal(5, 2)
  anguloInterincisal Decimal? @db.Decimal(5, 2)
  u1SN               Decimal? @db.Decimal(5, 2)
  impa               Decimal? @db.Decimal(5, 2)
  convexidadFacial   Decimal? @db.Decimal(5, 2)
  notes              String?
  createdBy          String?  @db.Uuid
  createdAt          DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model ClinicalHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String   @unique @db.Uuid
  medicalHistory   Json?
  dentalBackground String?
  observations     String?
  updatedAt        DateTime @updatedAt

  patient  Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  versions ClinicalHistoryVersion[]
}

model ClinicalHistoryVersion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicalHistoryId String   @db.Uuid
  medicalHistory    Json?
  dentalBackground  String?
  observations      String?
  changedBy         String   @db.Uuid
  createdAt         DateTime @default(now())

  clinicalHistory ClinicalHistory @relation(fields: [clinicalHistoryId], references: [id], onDelete: Cascade)
  author          Profile         @relation(fields: [changedBy], references: [id])

  @@index([clinicalHistoryId])
}

model Treatment {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String          @db.Uuid
  patientId        String          @db.Uuid
  name             String
  description      String?
  toothNumber      String?
  startDate        DateTime        @db.Date
  estimatedEndDate DateTime?       @db.Date
  status           TreatmentStatus @default(ACTIVO)
  budget           Decimal?        @db.Decimal(10, 2)
  finalCost        Decimal?        @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())

  clinic     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient    Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  media      CaseMedia[]
  diagnoses  Diagnosis[]
  payments   Payment[]
  moldCharts ToothMoldChart[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

model CaseMedia {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId         String   @db.Uuid
  patientId        String   @db.Uuid
  treatmentId      String?  @db.Uuid
  bucket           String // 'patients-profile', 'cases-images', 'cases-videos', 'radiographs', 'documents'
  fileUrl          String
  category         String?
  description      String?
  mimeType         String?
  size             Int?
  uploadedBy       String   @db.Uuid
  visibleToPatient Boolean  @default(false)
  createdAt        DateTime @default(now())

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([treatmentId])
}

model Appointment {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId       String            @db.Uuid
  branchId       String?           @db.Uuid
  patientId      String?           @db.Uuid
  doctorId       String?           @db.Uuid
  treatmentType  String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(DISPONIBLE)
  notes          String?
  clinicalNotes  String?
  reminderSentAt DateTime?
  createdAt      DateTime          @default(now())

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Profile? @relation(fields: [doctorId], references: [id])

  @@index([clinicId])
  @@index([branchId])
  @@index([patientId])
  @@index([startsAt])
  @@index([status])
}

model Payment {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String        @db.Uuid
  patientId    String        @db.Uuid
  treatmentId  String?       @db.Uuid
  amount       Decimal       @db.Decimal(10, 2)
  currency     String        @default("BOB")
  status       PaymentStatus @default(PENDIENTE)
  method       String?
  notes        String?
  receiptUrl   String?
  signatureUrl String?
  date         DateTime      @default(now())

  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment Treatment? @relation(fields: [treatmentId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([treatmentId])
}

model DoctorPayment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId     String   @db.Uuid
  doctorId     String   @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  currency     String   @default("BOB")
  description  String?
  date         DateTime @default(now())
  signatureUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor Profile @relation(fields: [doctorId], references: [id])

  @@index([clinicId])
  @@index([doctorId])
}

model TimelineEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String   @db.Uuid
  patientId   String   @db.Uuid
  eventType   String
  title       String
  description String?
  metadata    Json?
  severity    String?  @default("info")
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now())

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@index([patientId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId  String?  @db.Uuid
  userId    String   @db.Uuid
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([userId])
  @@index([entity, entityId])
}

model ToothMoldChart {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicId    String   @db.Uuid
  patientId   String   @db.Uuid
  treatmentId String?  @db.Uuid
  notes       String?
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic       Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient      Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  treatment    Treatment?             @relation(fields: [treatmentId], references: [id])
  measurements ToothMoldMeasurement[]

  @@index([clinicId])
  @@index([patientId])
  @@index([treatmentId])
}

model ToothMoldMeasurement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chartId        String   @db.Uuid
  arc            String // 'upper' | 'lower'
  moldLine       String // 'A' | 'B' | 'C' | 'D' | 'E'
  toothPosition  String // 'U1'..'U7' | 'L1'..'L7'
  measurementMm  Decimal? @db.Decimal(4, 2)
  biteAdjustment String? // '+1.0mm' | '+0.5mm' | 'media' | '-0.5mm' | '-1.0mm'
  isHighlighted  Boolean  @default(false)

  chart ToothMoldChart @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@index([chartId])
}

model CephalometricCase {
  id                    String    @id @default(cuid())
  clinicId              String    @db.Uuid
  patientId             String    @db.Uuid
  doctorId              String    @db.Uuid
  imageUrl              String
  imageWidth            Int
  imageHeight           Int
  pixelsPerMm           Float?
  landmarks             Json // [{ key: "N", x: 0.42, y: 0.31 }, ...]
  analysisResults       Json?
  primaryAnalysis       String    @default("steiner")
  reportTemplateVersion String?
  exportedReportUrl     String?
  duplicatedFromId      String?
  doctorSignatureUrl    String?
  reportContentHash     String?
  signedAt              DateTime?
  status                String    @default("draft")
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  clinic Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor Profile                  @relation(fields: [doctorId], references: [id])
  events CephalometricCaseEvent[]

  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
}

model CephalometricCaseEvent {
  id        String   @id @default(cuid())
  caseId    String
  action    String // "created" | "landmarks_updated" | "analysis_run" | "report_exported" | "duplicated" | "completed"
  doctorId  String   @db.Uuid
  createdAt DateTime @default(now())

  case CephalometricCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}
